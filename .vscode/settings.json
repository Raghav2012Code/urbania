{
    "clangd.arguments": [
        "--compile-commands-dir=${workspaceFolder}/build",
        "--query-driver=F:/msys64/ucrt64/bin/g++.exe"
    ],
    "cSpell.words": [
        "Urbania",
        "raylib",
        "RAYWHITE",
        "LIGHTGRAY"
    ],
    "[c]": {
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
        "editor.formatOnSave": true
    },
    "[cpp]": {
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
        "editor.formatOnSave": true
    }
}
